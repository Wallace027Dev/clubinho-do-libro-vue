generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  ADMIN
}

enum ClubBookStatus {
  CURRENT
  FINISHED
}

enum ActivityType {
  MEMBER_CREATED
  PROFILE_UPDATED
  BOOK_SELECTED
  BOOK_FINISHED
  BOOK_REVIEWED
  CHAPTER_STARTED
  CHAPTER_FINISHED
  CHAPTER_COMMENTED
}

enum ChapterProgressStatus {
  STARTED
  FINISHED
}

enum ChapterCommentReactionType {
  GOSTEI
  SOFRI
  SURPRESO
  SUSPEITO
  DISCUTIR
}

model User {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  selectedBooks ClubBook[] @relation("SelectedBooks")
  finishedBooks ClubBook[] @relation("FinishedBooks")
  activities    Activity[]
  chapterProgress ChapterProgress[]
  chapterComments ChapterComment[]
  chapterCommentReactions ChapterCommentReaction[]
  bookReviews BookReview[]
}

model Club {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  books      ClubBook[]
  activities Activity[]
}

model Book {
  id        String   @id @default(uuid())
  title     String
  author    String?
  coverUrl  String?
  createdAt DateTime @default(now())

  clubBooks ClubBook[]
}

model ClubBook {
  id               String         @id @default(uuid())
  clubId           String
  bookId           String
  status           ClubBookStatus @default(CURRENT)
  selectedAt       DateTime       @default(now())
  finishedAt       DateTime?
  selectedByUserId String?
  finishedByUserId String?

  club       Club  @relation(fields: [clubId], references: [id])
  book       Book  @relation(fields: [bookId], references: [id])
  selectedBy User? @relation("SelectedBooks", fields: [selectedByUserId], references: [id])
  finishedBy User? @relation("FinishedBooks", fields: [finishedByUserId], references: [id])
  chapters   Chapter[]
  reviews    BookReview[]

  @@index([clubId, status])
  @@index([bookId])
}

model BookReview {
  id         String   @id @default(uuid())
  clubBookId String
  userId     String
  rating     Int
  review     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clubBook ClubBook @relation(fields: [clubBookId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([clubBookId, userId])
  @@index([clubBookId])
}

model Chapter {
  id         String   @id @default(uuid())
  clubBookId String
  number     Int
  title      String
  createdAt  DateTime @default(now())

  clubBook ClubBook @relation(fields: [clubBookId], references: [id])
  progress ChapterProgress[]
  comments ChapterComment[]

  @@unique([clubBookId, number])
  @@index([clubBookId])
}

model ChapterProgress {
  id          String                @id @default(uuid())
  chapterId   String
  userId      String
  status      ChapterProgressStatus
  startedAt   DateTime              @default(now())
  finishedAt  DateTime?
  updatedAt   DateTime              @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([chapterId, userId])
  @@index([userId, status])
}

model ChapterComment {
  id        String   @id @default(uuid())
  chapterId String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   Chapter @relation(fields: [chapterId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
  reactions ChapterCommentReaction[]

  @@unique([chapterId, userId])
  @@index([chapterId, createdAt])
}

model ChapterCommentReaction {
  id        String                     @id @default(uuid())
  commentId String
  userId    String
  type      ChapterCommentReactionType
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  comment ChapterComment @relation(fields: [commentId], references: [id])
  user    User           @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([commentId, type])
}

model Activity {
  id        String       @id @default(uuid())
  clubId    String
  actorId   String?
  type      ActivityType
  message   String
  metadata  Json?
  createdAt DateTime     @default(now())

  club  Club  @relation(fields: [clubId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])

  @@index([clubId, createdAt])
}
