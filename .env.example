# Registro das variaveis de ambiente do Clubinho do Libro.
# Copie este arquivo para .env.local e preencha com valores reais.
# Nunca versione .env / .env.local (ja estao no .gitignore).

# --- Banco de dados ---
# String de conexao Postgres usada pelo Prisma e pelo dev-server.
# Em dev local, aponta para o Postgres do docker-compose.
#
# Em producao (Vercel + Supabase), use a URL do TRANSACTION POOLER
# (porta 6543) com ?pgbouncer=true — serverless abre muitas conexoes
# e a URL direta esgota o banco:
#   postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# A URL DIRETA (porta 5432) fica so para comandos de schema rodados da
# sua maquina (npx prisma db push):
#   postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL="postgresql://clubinho:clubinho@localhost:5432/clubinho_do_libro?schema=public"

# --- Autenticacao ---
# Senha usada no login administrativo (/login/admin).
ADMIN_PASSWORD="troque-esta-senha"

# Segredo para assinar o JWT de sessao. Gere uma string longa e aleatoria.
SESSION_SECRET="gere-uma-string-longa-e-aleatoria"

# --- Dev server local (nao usado em producao/Vercel) ---
# Porta em que o dev-server das funcoes /api sobe localmente.
# O Vite faz proxy de /api para esta porta.
API_PORT="3001"
