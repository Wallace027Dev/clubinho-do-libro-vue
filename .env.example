# Registro das variaveis de ambiente do Clubinho do Libro.
# Copie este arquivo para .env.local e preencha com valores reais.
# Nunca versione .env / .env.local (ja estao no .gitignore).

# --- Banco de dados ---
# String de conexao Postgres usada pelo Prisma e pelo dev-server.
# Em dev local, aponta para o Postgres do docker-compose.
#
# Em producao (Vercel + Supabase), use a URL do TRANSACTION POOLER
# (porta 6543) com ?pgbouncer=true — serverless abre muitas conexoes
# e a URL direta esgota o banco:
#   postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# A URL DIRETA (porta 5432) fica so para comandos de schema rodados da
# sua maquina (npx prisma db push):
#   postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
#
# ATENCAO ao gravar a URL na Vercel: NAO faca percent-encoding de caracteres
# especiais da senha (ex.: nao troque `$` por `%24`). Ali o valor eh injetado
# literalmente em process.env, sem dotenv, e o Prisma Client em RUNTIME nao
# decodifica o `%24` — ele manda a senha com o `%24` cru e o pooler rejeita com
# `28P01 password authentication failed`. Use o caractere literal (`$`) na
# Vercel. (No `.env` local o `%24` funciona, porque ali quem le eh o Prisma CLI,
# que decodifica — a diferenca CLI vs Client eh a pegadinha.)
DATABASE_URL="postgresql://clubinho:clubinho@localhost:5432/clubinho_do_libro?schema=public"

# --- Autenticacao ---
# Senha usada no login administrativo (/login/admin).
ADMIN_PASSWORD="troque-esta-senha"

# Segredo para assinar o JWT de sessao. Gere uma string longa e aleatoria.
SESSION_SECRET="gere-uma-string-longa-e-aleatoria"

# --- Dev server local (nao usado em producao/Vercel) ---
# Porta em que o dev-server das funcoes /api sobe localmente.
# O Vite faz proxy de /api para esta porta.
API_PORT="3001"

# --- Web Push (notificacoes) ---
# Gere um par de chaves VAPID uma vez com:  npx web-push generate-vapid-keys
# A PUBLICA vai tambem no build do frontend (VITE_VAPID_PUBLIC_KEY); a PRIVADA
# fica so no backend. Sem elas, o app funciona normal, so nao envia push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"

# Mesma chave PUBLICA acima, exposta ao frontend no build (Vite so injeta
# variaveis com prefixo VITE_). Necessaria para o navegador assinar o push.
VITE_VAPID_PUBLIC_KEY=""

# --- Busca de livro no sorteio (Google Books) ---
# Crie em console.cloud.google.com: habilite a "Books API" e gere uma API key.
# Fica SO no servidor (nada de prefixo VITE_, senao vaza no bundle).
# Sem ela a busca do Google responde 429 e o app cai automaticamente no Open
# Library, que nao pede chave mas tem cobertura pior de livro brasileiro
# (frequentemente sem capa e sem numero de paginas).
GOOGLE_BOOKS_API_KEY=""
